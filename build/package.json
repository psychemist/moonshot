{
  "name": "learning-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm run db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "mcp": "node --import tsx mcp/server.ts",
    "mcp:demo": "node --import tsx mcp/demo.ts",
    "coach": "node --import tsx mcp/coach.ts",
    "test:mcp": "vitest run mcp/server.test.ts",
    "browser:install": "playwright install chrome",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-users.ts",
    "prebuild": "npm run db:seed"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
